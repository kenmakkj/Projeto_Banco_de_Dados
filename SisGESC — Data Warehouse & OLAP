-- PROCEDURE 6: Carregar Fato Receita
CREATE PROCEDURE IF NOT EXISTS sp_etl_carregar_fato_receita()
BEGIN
    DECLARE v_registros INT DEFAULT 0;
    
    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        SELECT CONCAT('ERRO ao carregar fato receita: ', @@last_error_message) AS resultado;
    END;
    
    START TRANSACTION;
        
        -- Usar INSERT ... ON DUPLICATE KEY UPDATE para atualizar registros existentes
        INSERT INTO fato_receita (
            sk_aluno, sk_curso, sk_tempo_vencimento, sk_tempo_pagamento,
            numero_contrato, numero_mensalidade,
            valor_mensalidade_liquido, valor_desconto_bolsa,
            valor_multa, valor_juros,
            valor_total_devido, valor_pago, valor_em_aberto,
            dias_em_atraso, status_pagamento, eh_em_atraso
        )
        SELECT 
            da.sk_aluno,
            dc.sk_curso,
            CAST(DATE_FORMAT(m.data_vencimento, '%Y%m%d') AS UNSIGNED),
            CASE WHEN pg.data_pagamento IS NOT NULL 
                 THEN CAST(DATE_FORMAT(pg.data_pagamento, '%Y%m%d') AS UNSIGNED) 
                 ELSE NULL END,
            m.fk_contrato,
            m.numero_mensalidade,
            m.valor_liquido,
            COALESCE(SUM(db.valor_fixo_desconto), 0),
            m.valor_multa,
            m.valor_juros,
            m.valor_liquido + COALESCE(m.valor_multa, 0) + COALESCE(m.valor_juros, 0),
            COALESCE(pg.valor_pago, 0),
            (m.valor_liquido + COALESCE(m.valor_multa, 0) + COALESCE(m.valor_juros, 0)) - 
            COALESCE(pg.valor_pago, 0),
            DATEDIFF(CURDATE(), m.data_vencimento),
            sp.descricao,
            (m.data_vencimento < CURDATE() AND sp.descricao IN ('Pendente', 'Atrasado'))
        FROM sisgesc.tb_mensalidades m
        LEFT JOIN sisgesc.tb_pagamentos pg ON pg.fk_mensalidade = m.pk_mensalidade
        LEFT JOIN sisgesc.tb_contratos_educacionais ce ON ce.pk_contrato = m.fk_contrato
        LEFT JOIN sisgesc.tb_alunos a ON a.pk_fk_cpf = ce.fk_cpf_aluno
        LEFT JOIN sisgesc.tb_pessoas p ON p.pk_cpf = a.pk_fk_cpf
        LEFT JOIN dim_aluno da ON da.cpf_aluno = p.pk_cpf
        LEFT JOIN sisgesc.tb_aluno_curso ac ON ac.fk_cpf_aluno = a.pk_fk_cpf
        LEFT JOIN dim_curso dc ON dc.codigo_curso = ac.fk_curso
        LEFT JOIN sisgesc.tb_status_pagamento sp ON sp.pk_status_pagamento = m.fk_status
        LEFT JOIN sisgesc.tb_descontos_bolsas db ON db.fk_contrato = ce.pk_contrato
        WHERE m.pk_mensalidade IS NOT NULL
        GROUP BY m.pk_mensalidade, m.numero_mensalidade, m.valor_liquido,
                 m.valor_multa, m.valor_juros, m.data_vencimento,
                 pg.valor_pago, pg.data_pagamento, sp.descricao,
                 da.sk_aluno, dc.sk_curso
        ON DUPLICATE KEY UPDATE
            valor_pago = VALUES(valor_pago),
            valor_em_aberto = VALUES(valor_em_aberto),
            dias_em_atraso = VALUES(dias_em_atraso),
            eh_em_atraso = VALUES(eh_em_atraso),
            status_pagamento = VALUES(status_pagamento);
        
        SELECT ROW_COUNT() INTO v_registros;
        SELECT CONCAT('✓ ', v_registros, ' registros de receita carregados') AS resultado;
        
    COMMIT;
END$$

-- PROCEDURE 7: Carregar Fato Desempenho
CREATE PROCEDURE IF NOT EXISTS sp_etl_carregar_fato_desempenho()
BEGIN
    DECLARE v_registros INT DEFAULT 0;
    
    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        SELECT 'ERRO ao carregar fato desempenho' AS resultado;
    END;
    
    START TRANSACTION;
        
        INSERT INTO fato_desempenho (
            sk_aluno, sk_professor, sk_disciplina, sk_curso,
            sk_tempo_conclusao, numero_turma, numero_matricula,
            nota_obtida, frequencia_percentual, presencas, faltas,
            total_aulas, status_disciplina, eh_aprovado, eh_reprovado,
            semestre_cursado, ano_cursado
        )
        SELECT 
            da.sk_aluno,
            dp.sk_professor,
            dd.sk_disciplina,
            dc.sk_curso,
            CAST(DATE_FORMAT(n.data_lancamento, '%Y%m%d') AS UNSIGNED),
            t.pk_turma,
            md.pk_matricula_disciplina,
            n.valor_nota,
            ROUND(100.0 * f.presencas / (f.presencas + f.faltas), 0),
            f.presencas,
            f.faltas,
            f.presencas + f.faltas,
            CASE WHEN n.valor_nota >= 7 AND f.presencas >= ((f.presencas + f.faltas) * 0.75)
                 THEN 'Aprovado'
                 WHEN n.valor_nota < 7 THEN 'Reprovado'
                 ELSE 'Trancado' END,
            (n.valor_nota >= 7 AND f.presencas >= ((f.presencas + f.faltas) * 0.75)),
            (n.valor_nota < 7),
            t.semestre,
            YEAR(n.data_lancamento)
        FROM sisgesc.tb_notas n
        JOIN sisgesc.tb_turmas t ON t.pk_turma = n.fk_turma
        JOIN sisgesc.tb_matricula_disciplina md ON md.pk_matricula_disciplina = n.fk_matricula_disciplina
        JOIN sisgesc.tb_pessoas p ON p.pk_cpf = md.fk_aluno
        JOIN dim_aluno da ON da.cpf_aluno = p.pk_cpf
        JOIN dim_professor dp ON dp.cpf_professor = t.fk_professor
        JOIN dim_disciplina dd ON dd.codigo_disciplina = t.fk_disciplina
        JOIN dim_curso dc ON dc.codigo_curso = t.fk_curso
        JOIN sisgesc.tb_frequencias f ON f.fk_turma = t.pk_turma AND f.fk_aluno = md.fk_aluno
        ON DUPLICATE KEY UPDATE
            nota_obtida = VALUES(nota_obtida),
            frequencia_percentual = VALUES(frequencia_percentual),
            status_disciplina = VALUES(status_disciplina);
        
        SELECT ROW_COUNT() INTO v_registros;
        SELECT CONCAT('✓ ', v_registros, ' registros de desempenho carregados') AS resultado;
        
    COMMIT;
END$$

-- PROCEDURE 8: Carregar Fato Folha de Pagamento
CREATE PROCEDURE IF NOT EXISTS sp_etl_carregar_fato_folha()
BEGIN
    DECLARE v_registros INT DEFAULT 0;
    
    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        SELECT 'ERRO ao carregar fato folha' AS resultado;
    END;
    
    START TRANSACTION;
        
        INSERT INTO fato_folha_pagamento (
            sk_professor, sk_tempo, numero_folha,
            mes_referencia, ano_referencia,
            salario_base, desconto_inss, desconto_irrf,
            salario_bruto, total_deduções, salario_liquido
        )
        SELECT 
            dp.sk_professor,
            CAST(DATE_FORMAT(fp.data_folha, '%Y%m%d') AS UNSIGNED),
            fp.pk_folha,
            MONTH(fp.data_folha),
            YEAR(fp.data_folha),
            fp.salario_base,
            ROUND(fp.salario_base * 0.08, 2),  -- INSS aproximado
            ROUND(fp.salario_base * 0.075, 2), -- IRRF aproximado
            fp.salario_base,
            ROUND(fp.salario_base * 0.155, 2), -- Deduções aprox
            fp.salario_bruto
        FROM sisgesc.tb_folha_pagamento fp
        JOIN sisgesc.tb_funcionarios f ON f.pk_fk_cpf = fp.fk_funcionario
        JOIN dim_professor dp ON dp.cpf_professor = f.pk_fk_cpf
        ON DUPLICATE KEY UPDATE
            salario_bruto = VALUES(salario_bruto),
            total_deduções = VALUES(total_deduções),
            salario_liquido = VALUES(salario_liquido);
        
        SELECT ROW_COUNT() INTO v_registros;
        SELECT CONCAT('✓ ', v_registros, ' registros de folha carregados') AS resultado;
        
    COMMIT;
END$$

-- PROCEDURE 9: MASTER ETL - Executa todos os carregamentos em sequência
CREATE PROCEDURE IF NOT EXISTS sp_etl_carga_completa_dw()
BEGIN
    DECLARE v_inicio DATETIME;
    DECLARE v_fim DATETIME;
    
    SET v_inicio = NOW();
    
    SELECT '🚀 INICIANDO CARGA DO DATA WAREHOUSE...' AS log;
    
    -- Carrega dimensões (na ordem correta de dependências)
    CALL sp_etl_carregar_tempo();
    CALL sp_etl_carregar_cursos();
    CALL sp_etl_carregar_alunos();
    CALL sp_etl_carregar_professores();
    CALL sp_etl_carregar_disciplinas();
    
    -- Carrega fatos (depois das dimensões)
    CALL sp_etl_carregar_fato_receita();
    CALL sp_etl_carregar_fato_desempenho();
    CALL sp_etl_carregar_fato_folha();
    
    SET v_fim = NOW();
    
    SELECT CONCAT(
        '✅ CARGA COMPLETA FINALIZADA\n',
        'Início: ', v_inicio, '\n',
        'Fim: ', v_fim, '\n',
        'Duração: ', TIMEDIFF(v_fim, v_inicio)
    ) AS resultado;
    
END$$

