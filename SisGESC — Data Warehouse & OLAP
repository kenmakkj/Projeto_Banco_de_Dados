-- ==============================================================================
-- TABELA DE FATOS: RECEITA FINANCEIRA (Star Schema)
-- Cada registro = uma mensalidade com seus valores
-- Métrica principal: Receita da Instituição
-- ==============================================================================

CREATE TABLE IF NOT EXISTS fato_receita (
    -- Chaves Surrogadas das Dimensões
    sk_aluno INT,                
    sk_curso INT,
    sk_tempo_vencimento INT,  -- Data de vencimento
    sk_tempo_pagamento INT,   -- Data de pagamento (NULL se não pago)
    
    -- Business Keys para rastreabilidade
    numero_contrato INT,
    numero_mensalidade INT,
    
    -- MÉTRICAS DE RECEITA
    valor_mensalidade_liquido DECIMAL(10, 2),
    valor_desconto_bolsa DECIMAL(10, 2),
    valor_desconto_outro DECIMAL(10, 2),
    valor_multa DECIMAL(10, 2),
    valor_juros DECIMAL(10, 2),
    
    -- Cálculos Derivados
    valor_total_devido DECIMAL(10, 2),
    valor_pago DECIMAL(10, 2),
    valor_em_aberto DECIMAL(10, 2),
    
    -- ANÁLISE DE PAGAMENTO
    dias_em_atraso INT DEFAULT 0,
    status_pagamento VARCHAR(50), -- Pago, Pendente, Atrasado
    vezes_renegociado INT DEFAULT 0,
    eh_em_atraso BOOLEAN DEFAULT FALSE,
    
    -- Chaves Estrangeiras
    CONSTRAINT fk_fato_receita_aluno FOREIGN KEY (sk_aluno) 
        REFERENCES dim_aluno(sk_aluno),
    CONSTRAINT fk_fato_receita_curso FOREIGN KEY (sk_curso) 
        REFERENCES dim_curso(sk_curso),
    CONSTRAINT fk_fato_receita_tempo_venc FOREIGN KEY (sk_tempo_vencimento) 
        REFERENCES dim_tempo(sk_tempo),
    CONSTRAINT fk_fato_receita_tempo_pag FOREIGN KEY (sk_tempo_pagamento) 
        REFERENCES dim_tempo(sk_tempo),
    
    -- Índices para MÁXIMA performance em análises
    PRIMARY KEY (sk_aluno, sk_curso, sk_tempo_vencimento, numero_mensalidade),
    INDEX idx_status (status_pagamento, sk_tempo_vencimento),
    INDEX idx_atraso (eh_em_atraso, sk_curso),
    INDEX idx_curso_tempo (sk_curso, sk_tempo_vencimento),
    INDEX idx_aluno_tempo (sk_aluno, sk_tempo_vencimento)
) ENGINE=InnoDB;

