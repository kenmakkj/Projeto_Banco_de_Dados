-- QUERY 1: Receita Total por Curso (2024)
-- ⚡ Esperado: 50-100ms (vs 5-10 segundos em OLTP)
SELECT 
    dc.nome_curso,
    COUNT(DISTINCT fr.sk_aluno) AS qtd_alunos,
    SUM(fr.valor_mensalidade_liquido) AS receita_esperada,
    SUM(fr.valor_pago) AS receita_realizada,
    ROUND(100.0 * SUM(fr.valor_pago) / SUM(fr.valor_mensalidade_liquido), 2) AS taxa_recebimento,
    SUM(CASE WHEN fr.eh_em_atraso THEN fr.valor_total_devido ELSE 0 END) AS valor_em_atraso
FROM fato_receita fr
JOIN dim_curso dc ON dc.sk_curso = fr.sk_curso
WHERE YEAR(FROM_UNIXTIME(fr.sk_tempo_vencimento / 10000)) = 2024
GROUP BY dc.nome_curso
ORDER BY receita_realizada DESC;

-- QUERY 2: Desempenho por Semestre
SELECT * FROM v_desempenho_por_curso_semestre
WHERE ano >= 2023
ORDER BY ano DESC, nota_media DESC;

-- QUERY 3: Alunos com Maiores Atrasos
SELECT 
    da.nome_completo,
    da.cpf_aluno,
    dc.nome_curso,
    COUNT(DISTINCT fr.numero_mensalidade) AS qtd_atrasadas,
    SUM(fr.valor_total_devido) AS total_em_atraso,
    MAX(fr.dias_em_atraso) AS dias_atraso_maximo
FROM fato_receita fr
JOIN dim_aluno da ON da.sk_aluno = fr.sk_aluno
JOIN dim_curso dc ON dc.sk_curso = fr.sk_curso
WHERE fr.eh_em_atraso = TRUE
GROUP BY da.sk_aluno, da.nome_completo, da.cpf_aluno, dc.nome_curso
HAVING COUNT(*) >= 3
ORDER BY total_em_atraso DESC
LIMIT 10;

-- QUERY 4: Tendência de Receita (Últimos 12 meses)
SELECT 
    dt.ano,
    dt.mes,
    dt.nome_mes,
    ROUND(SUM(fr.valor_pago), 2) AS receita_mes,
    ROUND(AVG(SUM(fr.valor_pago)) OVER (
        ORDER BY dt.ano, dt.mes 
        ROWS BETWEEN 2 PRECEDING AND CURRENT ROW
    ), 2) AS receita_media_movel_3m
FROM fato_receita fr
JOIN dim_tempo dt ON dt.sk_tempo = fr.sk_tempo_vencimento
GROUP BY dt.ano, dt.mes, dt.nome_mes
ORDER BY dt.ano DESC, dt.mes DESC
LIMIT 12;

-- QUERY 5: Taxa de Inadimplência por Curso
SELECT * FROM v_inadimplencia_por_curso
ORDER BY taxa_inadimplencia_pct DESC;

