DROP TABLE IF EXISTS sisgesc.tb_verbas;
DROP TABLE IF EXISTS sisgesc.tb_folha_pagamento;
DROP TABLE IF EXISTS sisgesc.tb_funcionario_beneficio;
DROP TABLE IF EXISTS sisgesc.tb_beneficios;
DROP TABLE IF EXISTS sisgesc.tb_professores;
DROP TABLE IF EXISTS sisgesc.tb_titulacoes;
DROP TABLE IF EXISTS sisgesc.tb_historico_cargos;
DROP TABLE IF EXISTS sisgesc.tb_funcionarios;
DROP TABLE IF EXISTS sisgesc.tb_cargos;
DROP TABLE IF EXISTS sisgesc.tb_departamentos;

-- Módulo Acadêmico
DROP TABLE IF EXISTS sisgesc.tb_faltas;
DROP TABLE IF EXISTS sisgesc.tb_notas;
DROP TABLE IF EXISTS sisgesc.tb_log_notas;
DROP TABLE IF EXISTS sisgesc.tb_avaliacoes;
