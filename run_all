DROP TABLE IF EXISTS sisgesc.tb_salas;
DROP TABLE IF EXISTS sisgesc.tb_turmas;
DROP TABLE IF EXISTS sisgesc.tb_periodos;
DROP TABLE IF EXISTS sisgesc.tb_pre_requisitos;
DROP TABLE IF EXISTS sisgesc.tb_grade_curricular;
DROP TABLE IF EXISTS sisgesc.tb_disciplinas;
DROP TABLE IF EXISTS sisgesc.tb_historico_status_aluno;
DROP TABLE IF EXISTS sisgesc.tb_aluno_curso;
DROP TABLE IF EXISTS sisgesc.tb_alunos;
DROP TABLE IF EXISTS sisgesc.tb_status_aluno;
DROP TABLE IF EXISTS sisgesc.tb_cursos;
DROP TABLE IF EXISTS sisgesc.tb_tipo_curso;

-- Base / Pessoas
DROP TABLE IF EXISTS sisgesc.tb_emails;
DROP TABLE IF EXISTS sisgesc.tb_telefones;
DROP TABLE IF EXISTS sisgesc.tb_enderecos;
DROP TABLE IF EXISTS sisgesc.tb_cep;
DROP TABLE IF EXISTS sisgesc.tb_pessoas;
DROP TABLE IF EXISTS sisgesc.tb_schema_version;

-- Views
DROP VIEW IF EXISTS sisgesc.vw_mensalidades;
DROP VIEW IF EXISTS sisgesc.vw_folha_pagamento;

SET FOREIGN_KEY_CHECKS = 1;

SELECT '>>> PASSO 1 CONCLUÍDO.' AS log;

-- =============================================================================
-- PASSO 2 — DDL: Criação do banco OLTP (sisgesc)
-- =============================================================================
SELECT '>>> PASSO 2: DDL — criando estrutura do banco sisgesc...' AS log;

SOURCE SisGESC_Script_DDL_otimizado.sql;

SELECT '>>> PASSO 2 CONCLUÍDO.' AS log;

-- =============================================================================
-- PASSO 3 — DML: Carga de dados operacionais + prova de idempotência
-- =============================================================================
SELECT '>>> PASSO 3: DML — carregando dados e validando idempotência...' AS log;

SOURCE SisGESC_Script_DML_corrigido.sql;

SELECT '>>> PASSO 3 CONCLUÍDO.' AS log;

-- =============================================================================
-- PASSO 4 — OLTP: Stored procedures + EXPLAIN de performance (Fase 5)
-- =============================================================================
SELECT '>>> PASSO 4: OLTP Procedures + Performance (EXPLAIN)...' AS log;

SOURCE SisGESC_Script_Governanca_corrigido.sql;

SELECT '>>> PASSO 4 CONCLUÍDO.' AS log;

-- =============================================================================
-- PASSO 5 — OLAP: Data Warehouse + ETL
-- =============================================================================
SELECT '>>> PASSO 5: OLAP — criando Data Warehouse e carregando ETL...' AS log;

SOURCE SisGESC_Data_Warehouse_OLAP_corrigido.sql;

SELECT '>>> PASSO 5 CONCLUÍDO.' AS log;

-- =============================================================================
-- PASSO 6 — VALIDAÇÃO FINAL: OLTP = OLAP
-- =============================================================================
SELECT '>>> PASSO 6: Validação OLTP × OLAP...' AS log;

SELECT 'OLTP — tb_mensalidades'         AS origem, SUM(valor_liquido)             AS soma_total FROM sisgesc.tb_mensalidades
UNION ALL
SELECT 'OLAP — fato_receita',                       SUM(valor_mensalidade_liquido) AS soma_total FROM dw_sisgesc.fato_receita;

-- Os dois valores DEVEM ser iguais. Diferença = erro no ETL.

SELECT '╔══════════════════════════════════════════════╗' AS log;
SELECT '║   SisGESC — INSTALAÇÃO COMPLETA FINALIZADA   ║' AS log;
SELECT '╚══════════════════════════════════════════════╝' AS log;
SELECT NOW() AS fim_execucao;
