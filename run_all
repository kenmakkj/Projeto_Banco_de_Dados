-- =============================================================================
-- SisGESC — run_all.sql
-- Script único de orquestração — executa TODO o projeto na ordem correta.
-- Sistema de Gestão Escolar — Universidade Privada
--
-- COMO USAR:
--   Linha de comando:
--     mysql -u <usuario> -p < run_all.sql
--
--   MySQL Workbench / DBeaver:
--     Abra este arquivo e execute como script.
--
-- ORDEM DE EXECUÇÃO:
--   1. Reset (DROP de todos os objetos existentes)
--   2. DDL   (criação das tabelas OLTP — sisgesc)
--   3. DML   (carga de dados operacionais + prova de idempotência)
--   4. OLTP  (stored procedures + EXPLAIN de performance)
--   5. OLAP  (criação do Data Warehouse dw_sisgesc + ETL)
-- =============================================================================

SELECT '╔══════════════════════════════════════════════╗' AS log;
SELECT '║   SisGESC — INSTALAÇÃO COMPLETA INICIADA     ║' AS log;
SELECT '╚══════════════════════════════════════════════╝' AS log;
SELECT NOW() AS inicio_execucao;

-- =============================================================================
-- PASSO 1 — RESET (DROP de objetos existentes)
-- =============================================================================
SELECT '>>> PASSO 1: Reset — removendo objetos existentes...' AS log;

SET FOREIGN_KEY_CHECKS = 0;

DROP DATABASE IF EXISTS dw_sisgesc;  -- Data Warehouse

-- Módulo Financeiro
DROP TABLE IF EXISTS sisgesc.tb_pagamentos;
